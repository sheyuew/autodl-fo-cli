{
  "name": "autodl-fo-cli",
  "version": "0.6.0",
  "private": true,
  "description": "AutoDL 子账号本地 CLI：抢卡、新建克隆、数据盘扩容与 AutoPanel，支持 Codex 和 JSON 输出",
  "type": "module",
  "bin": {
    "fo": "cli.mjs"
  },
  "scripts": {
    "start": "node cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:terminal": "python3 tests/terminal.integration.py",
    "test:native": "node --test native/tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
